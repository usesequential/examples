# REQUIRED. Your project's "sequential" ingest key. It starts with sq_sequential_.
# Find it in Sequential under Settings > Projects > your project > Setup (the data-key value).
NEXT_PUBLIC_SEQUENTIAL_KEY=

# Optional. The ingest host. The hosted default is https://api.usesequential.com.
NEXT_PUBLIC_SEQUENTIAL_API=https://api.usesequential.com

# Optional. Your app version, put on every event as the release.
# When this is empty, the build uses VERCEL_GIT_COMMIT_SHA (set by Vercel) if it is present.
NEXT_PUBLIC_SEQUENTIAL_RELEASE=
